# Copy to backend/.env and frontend/.env.local

# Anemi Postgres only (cluster 18/anemi on 5434 — not VMS 5432)
DATABASE_URL=postgresql://anemi:anemi@127.0.0.1:5434/anemi

# Nest
PORT=4100
NODE_ENV=development
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Required in production: random string, 32+ characters
JWT_SECRET=change-me-to-a-long-random-string
# Optional. If unset, TOTP secrets are keyed from JWT_SECRET
MFA_SECRET=
SENTRY_DSN=
MEDIA_ROOT=/var/www/anemi/data/media
# rsync licensed files here, then import from CMS
MEDIA_INBOX=/var/www/anemi/data/inbox
# When nginx proxies /media, Nest hands the file off with X-Accel-Redirect
MEDIA_ACCEL_PREFIX=/internal-anemi-media/

# Next
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Used in invite and password-reset emails (falls back to CORS_ORIGINS)
PUBLIC_SITE_URL=http://127.0.0.1:3100
BACKEND_INTERNAL_URL=http://127.0.0.1:4100
# Watch Together WebSocket (same host as the API in production)
NEXT_PUBLIC_WS_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SENTRY_DSN=

# Optional: send the footer newsletter from Admin → Newsletter
# Also used for the contact form and weekly schedule mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Or a full URL instead of the fields above:
# SMTP_URL=smtp://user:pass@localhost:587
FFMPEG_PATH=
