# Example nginx front for Anemi. Replace anemi.example.com and TLS paths.
# Next.js on 3100 already rewrites /api, /media, and /socket.io to the API on 4100.

server {
    listen 443 ssl http2;
    server_name anemi.example.com;

    ssl_certificate     /etc/ssl/anemi/fullchain.pem;
    ssl_certificate_key /etc/ssl/anemi/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 400m;
    }
}
